      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Строковые операции\n",
        "\n",
        "data = [\"one\", \"TWO\", \"tHREE tHREE\", \"fouR fouR\"]\n",
        "print(data)\n",
        "\n",
        "print([s.capitalize( for s in data)])\n",
        "\n",
        "names = pd.Series(data)\n",
        "print(names)\n",
        "\n",
        "# операции через атрибут str\n",
        "print(names.str.capitalize())\n",
        "\n",
        "print(names.lower())\n",
        "\n",
        "print(names.len())\n",
        "\n",
        "print(names.startswith())\n",
        "\n",
        "print(names.split())\n",
        "\n",
        "data = [\"one1 one2 one3\", \"TWO\", \"tHREE tHREE\", \"fouR fouR\"]\n",
        "names = pd.Series(data)\n",
        "\n",
        "rgex = r\"([a-z0-9]+\\s)([a-z0-9]+\\s).*\"\n",
        "\n",
        "a = names.str.extract(rgex)\n",
        "\n",
        "print(a)\n",
        "\n",
        "print(type(a))\n",
        "\n",
        "print(names.str.get(2))\n",
        "print(names.str.get[2])\n",
        "\n",
        "print(names.str.[0:3])\n",
        "print(names.str.slice(0,3))\n",
        "\n",
        "print(names.str[-1])"
      ]
    },
